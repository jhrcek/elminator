cabal-version: 2.0
name: elminator
version: 0.2.4.4
synopsis: Generate ELM types/encoders/decoders from Haskell types.
description: Please see the README on GitHub at <https://github.com/sras/elminator#readme>
category: Code Generation, Elm
author: Sandeep.C.R
maintainer: sandeep@sras.me
copyright: 2019 Sandeep.C.R
license: BSD3
license-file: LICENSE
build-type: Simple
extra-source-files:
  README.md

extra-doc-files:
  ChangeLog.md

tested-with:
  ghc ==9.6.7 || ==9.8.4 || ==9.10.3 || ==9.12.2

flag e2e
  description: Build the end-to-end integration test suite (requires elm and node)
  default: False
  manual: True

source-repository head
  type: git
  location: https://github.com/sras/elminator.git

library
  exposed-modules:
    Elminator

  other-modules:
    Elminator.ELM.Elm18
    Elminator.ELM.Elm19
    Elminator.ELM.Generator
    Elminator.ELM.Render
    Elminator.Generics.Simple
    Elminator.Lib

  hs-source-dirs:
    src

  ghc-options: -Wall
  build-depends:
    aeson >=2.2.3 && <2.3,
    base >=4.7 && <5,
    containers >=0.6 && <0.9,
    mtl >=2.3.1 && <2.4,
    template-haskell >=2.20.0 && <2.25,
    text >=2.0 && <2.2

  default-language: Haskell2010

test-suite elminator-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs:
    test

  ghc-options:
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base >=4.7 && <5

  default-language: Haskell2010

test-suite elminator-e2e
  if !flag(e2e)
    buildable: False
  type: exitcode-stdio-1.0
  main-is: TestMain.hs
  other-modules:
    AllElmSources
    TestInstances
    TestShadowTypes
    TestTypes
    TestValues
    TestWrapper

  hs-source-dirs:
    test-e2e

  ghc-options: -Wall
  build-depends:
    aeson >=2.2.3 && <2.3,
    base >=4.7 && <5,
    bytestring,
    containers,
    directory,
    elminator,
    process,
    tasty,
    tasty-hunit,
    template-haskell,
    text

  default-language: Haskell2010
