    template-haskell >=2.20.0 && <2.25,
    text >=2.0 && <2.2

  default-language: Haskell2010

test-suite elminator-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
    Paths_elminator

  hs-source-dirs:
    test

  ghc-options:
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base >=4.7 && <5

  default-language: Haskell2010
